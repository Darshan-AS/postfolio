{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Postfolio (Staging - Local Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "staging",
        "--dart-define-from-file=config/local.json"
      ]
    },
    {
      "name": "Postfolio (Prod - Current Device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "prod"
      ]
    },
    {
      "name": "Postfolio (Chrome - Local Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=3000",
        "--dart-define-from-file=config/local.json"
      ]
    },
    {
      "name": "Postfolio (Chrome - Production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=3000"
      ]
    },
    {
      "name": "Postfolio (macOS - Local Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "toolArgs": [
        "--dart-define-from-file=config/local.json"
      ]
    },
    {
      "name": "Postfolio (iOS Simulator - Local Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "ios",
      "toolArgs": [
        "--dart-define-from-file=config/local.json"
      ]
    }
  ]
}
