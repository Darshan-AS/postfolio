{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "maxInstances": 5,
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|main.dart.wasm|main.dart.mjs|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": false
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "postfolio-app",
          "appId": "1:143378829514:android:41d9df0d03361b6d20a433",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "postfolio-app",
          "appId": "1:143378829514:ios:ede1817061a7a10320a433",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "postfolio-app",
          "appId": "1:143378829514:ios:ede1817061a7a10320a433",
          "uploadDebugSymbols": true,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "postfolio-app",
          "configurations": {
            "android": "1:143378829514:android:41d9df0d03361b6d20a433",
            "ios": "1:143378829514:ios:ede1817061a7a10320a433",
            "macos": "1:143378829514:ios:ede1817061a7a10320a433",
            "web": "1:143378829514:web:07d791d58b39110420a433",
            "windows": "1:143378829514:web:ada2f101378be46220a433"
          }
        }
      }
    }
  }
}
